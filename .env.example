# ===== データベース =====
DATABASE_URL=postgres://app:app@localhost:55433/app
# 商標データ（001）: 開発では pnpm --filter @app/importer seed-fixture で検証用データを取り込む
# 結合テストと E2E テストで使う DB
TEST_DATABASE_URL=postgres://app:app@localhost:55433/app_test

# ===== Better Auth =====
# 32 文字以上のランダムな文字列（例: openssl rand -base64 32）
BETTER_AUTH_SECRET=change-me-to-a-random-32-characters-or-more
BETTER_AUTH_URL=http://localhost:3000

# ===== Google OAuth（任意。未設定なら Google のボタンを出さない） =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== メール =====
# resend | file
MAIL_TRANSPORT=file
RESEND_API_KEY=
MAIL_FROM="ネーミングチェッカー <no-reply@example.com>"
MAIL_OUTBOX_DIR=.mail-outbox

# ===== 運用 =====
# 1 でメンテナンス表示
MAINTENANCE_MODE=0
# 接続元の判定で信頼するプロキシの IP（カンマ区切り）
TRUSTED_PROXY_IPS=127.0.0.1
SUPPORT_CONTACT=support@example.com
LOG_LEVEL=info
# static にすると、漏えいパスワードの確認を外部に問い合わせない（E2E テスト用）
PWNED_CHECK=
